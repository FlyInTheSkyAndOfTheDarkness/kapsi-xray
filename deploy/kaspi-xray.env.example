NODE_ENV=production
PORT=8787

# Set a long random value before production start:
# openssl rand -hex 32
JWT_SECRET=replace_with_long_random_secret

# Public URL used by Taobao bookmark/import helpers.
PUBLIC_BASE_URL=https://kaspi.example.kz

# Competitor polling interval.
POLL_HOURS=6

# Kaspi rate-limits by IP and answers datacenter addresses with 429 + an HTML
# anti-bot page, which reads as an empty catalog everywhere in the app. Route
# kaspi.kz through an HTTP(S) proxy that exits in Kazakhstan to avoid it.
# Leave empty for direct egress. SOCKS proxies are not supported.
# No paid proxy needed: deploy/kz-relay/relay.js turns any machine on a Kazakh
# connection into one over an SSH tunnel — see deploy/README.md.
KASPI_PROXY_URL=

# The proxy carries the public listing only; the merchant cabinet API stays on
# direct egress so the seller's token never passes through a third-party relay.
# Set to 1 only if the token API turns out to be blocked too.
KASPI_PROXY_MERCHANT_API=

# Milliseconds between consecutive public Kaspi calls. Lower is faster but
# closer to the limiter. Kaspi serves 12 products per page, so a 400-product
# catalog is ~34 calls — raise this if 429s reappear, lower it for speed.
KASPI_MIN_GAP_MS=700

# Hard stop on catalog pages, in case a listing never reports its end.
# 60 pages covers roughly 720 products.
KASPI_MAX_PAGES=60

# How long a fetched catalog is reused before going back to Kaspi.
KASPI_CACHE_TTL_MS=600000

# How long a cached answer may still be served once Kaspi starts refusing.
KASPI_CACHE_STALE_MS=86400000

# Quiet period after a 429 before public calls are attempted again.
KASPI_COOLDOWN_MS=60000

# Optional: image translation providers.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
