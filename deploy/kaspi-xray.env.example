NODE_ENV=production
PORT=8787

# Set a long random value before production start:
# openssl rand -hex 32
JWT_SECRET=replace_with_long_random_secret

# Public URL used by Taobao bookmark/import helpers.
PUBLIC_BASE_URL=https://kaspi.example.kz

# Competitor polling interval.
POLL_HOURS=6

# Optional: image translation providers.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
