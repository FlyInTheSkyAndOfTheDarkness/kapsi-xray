NODE_ENV=production
PORT=8787

# Set a long random value before production start:
# openssl rand -hex 32
JWT_SECRET=replace_with_long_random_secret

# Public URL used by Taobao bookmark/import helpers and by the Kaspi price-list
# feed. Kaspi downloads https://<this>/feed/kaspi/<token>.xml and loads product
# photos from the same origin, so it must be reachable from the internet.
PUBLIC_BASE_URL=https://kaspi.example.kz

# Competitor polling interval.
POLL_HOURS=6

# Cards auto-published to Kaspi per 10-minute scheduler pass (feeds with
# "Автопубликация карточек" enabled).
AUTO_PUBLISH_PER_RUN=5

# Optional: image translation providers.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
